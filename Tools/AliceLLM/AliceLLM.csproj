<Project Sdk="Microsoft.NET.Sdk">
  <!-- Опыт: понимание вопроса маленькой LLM (Qwen) через тот же llama.cpp, что у AliceSemantic -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);ALICE_SEMANTIC_HARNESS</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../CustomItems/AliceSemantic.cs" />
    <Compile Include="../../CustomItems/Items/AliceIntents.cs" />
  </ItemGroup>
</Project>
