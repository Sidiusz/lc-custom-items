<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SidiuszCustomItems</AssemblyName>
    <RootNamespace>CustomItems</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- BepInEx и UnityEngine.Modules 2022.x лежат в фиде BepInEx, а не на nuget.org -->
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>

    <!-- Путь к папке BepInEx/plugins профиля r2modman/Gale. Если задан, после сборки
         DLL и AssetBundle копируются туда автоматически. Пример:
         dotnet build -p:PluginDir="C:\Users\me\AppData\Roaming\r2modmanPlus-local\LethalCompany\profiles\Dev\BepInEx\plugins" -->
    <PluginDir></PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
    <!-- Публицизированные библиотеки игры (Assembly-CSharp и т.д.), только для компиляции -->
    <PackageReference Include="LethalCompany.GameLibs.Steam" Version="81.0.5-ngd.0" PrivateAssets="all" />
    <PackageReference Include="Evaisa.LethalLib" Version="1.2.0" PrivateAssets="all" />
    <!-- Офлайн-распознавание речи для Яндекс Станции. Нативные библиотеки берём сами (ниже), а не из build/ пакета:
         тот кладёт их под ОС сборки, а игре нужны Windows x64 -->
    <PackageReference Include="Vosk" Version="0.3.38" ExcludeAssets="build" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Скрипты предметов собираются отдельной сборкой SidiuszCustomItems.Items (см. Items/) -->
  <ItemGroup>
    <Compile Remove="Items/**" />
    <None Remove="Items/**" />
    <ProjectReference Include="Items\CustomItems.Items.csproj" />
  </ItemGroup>

  <!-- Перевод для русификатора LethalRussian -->
  <ItemGroup>
    <None Include="translations\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="intents.txt" LogicalName="SidiuszCustomItems.intents.txt" />
  </ItemGroup>

  <!-- AssetBundle из Unity кладётся в Bundles/ в корне репозитория -->
  <ItemGroup>
    <None Include="..\Bundles\sidiuszcustomitems" Condition="Exists('..\Bundles\sidiuszcustomitems')" CopyToOutputDirectory="PreserveNewest" Link="sidiuszcustomitems" />
  </ItemGroup>

  <!-- Vosk для Яндекс Станции: vosk/ рядом с DLL мода (нативные библиотеки Windows x64 и русская модель).
       Модель — vosk-model-small-ru-0.22 как есть (Vosk/model-ru): сразу слышит «Алиса» и даёт черновой текст,
       сам вопрос точно распознаёт Whisper. Своя модель на большой акустике (Tools/YandexStation/model/build.sh)
       больше не кладётся: она отставала на 1,5–2 с и весила 78 МБ. -->
  <ItemGroup>
    <None Remove="Vosk/**" />
  </ItemGroup>

  <Target Name="CopyVosk" AfterTargets="Build">
    <PropertyGroup>
      <VoskModelOut>$(TargetDir)vosk/model-ru</VoskModelOut>
    </PropertyGroup>
    <ItemGroup>
      <VoskNative Include="$(PkgVosk)/build/lib/win-x64/*.dll" />
      <VoskModel Include="Vosk/model-ru/**/*" />
    </ItemGroup>
    <Copy SourceFiles="$(PkgVosk)/lib/netstandard2.0/Vosk.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VoskNative)" DestinationFolder="$(TargetDir)vosk" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VoskModel)" DestinationFolder="$(VoskModelOut)/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Понимание вопросов Алисы по смыслу (AliceSemantic.cs): alice-semantic/ рядом с DLL мода.
       Модель rubert-mini-frida (f16 GGUF, 68 МБ) лежит в репозитории, её делает Tools/AliceSemantic/bert2gguf.py.
       llama.cpp для Windows x64 — из пакета LLamaSharp.Backend.Cpu (только нативные DLL, сам LLamaSharp не нужен):
       сборки под AVX2 и AVX, мод выбирает по процессору. -->
  <ItemGroup>
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <None Remove="AliceSemantic/**" />
  </ItemGroup>

  <Target Name="CopyAliceSemantic" AfterTargets="Build">
    <PropertyGroup>
      <AliceSemanticOut>$(TargetDir)alice-semantic</AliceSemanticOut>
      <AliceSemanticNative>$(PkgLLamaSharp_Backend_Cpu)/LLamaSharpRuntimes/win-x64/native</AliceSemanticNative>
    </PropertyGroup>
    <ItemGroup>
      <AliceSemanticDll Include="$(AliceSemanticNative)/avx2/ggml-base.dll;$(AliceSemanticNative)/avx2/ggml-cpu.dll;$(AliceSemanticNative)/avx2/ggml.dll;$(AliceSemanticNative)/avx2/llama.dll" Cpu="avx2" />
      <AliceSemanticDll Include="$(AliceSemanticNative)/avx/ggml-base.dll;$(AliceSemanticNative)/avx/ggml-cpu.dll;$(AliceSemanticNative)/avx/ggml.dll;$(AliceSemanticNative)/avx/llama.dll" Cpu="avx" />
    </ItemGroup>
    <Error Condition="!Exists('$(AliceSemanticNative)/avx2/llama.dll')" Text="Нет llama.dll в пакете LLamaSharp.Backend.Cpu ($(AliceSemanticNative))" />
    <Copy SourceFiles="@(AliceSemanticDll)" DestinationFolder="$(AliceSemanticOut)/%(Cpu)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="AliceSemantic/rubert-mini-frida-f16.gguf" DestinationFolder="$(AliceSemanticOut)" SkipUnchangedFiles="true" />
  </Target>


  <!-- ==== Whisper для Яндекс Станции (AliceWhisper.cs) ====
       whisper/ рядом с DLL мода: cpu/ и vulkan/ — нативные whisper.cpp 1.8.x для Windows x64 из пакетов
       Whisper.net.Runtime и Whisper.net.Runtime.Vulkan (берём только файлы библиотек, сам Whisper.net не нужен),
       и модель ggml-small-q8_0.bin (264 МБ). Модели в git нет (GitHub не берёт файлы больше 100 МБ): сборка
       качает её с Hugging Face в obj/whisper/ (один раз) и сверяет SHA-256. Без сети — только предупреждение,
       мод работает на одном Vosk. Не качать: dotnet build -p:WhisperDownload=false -->
  <PropertyGroup>
    <WhisperDownload Condition="'$(WhisperDownload)' == ''">true</WhisperDownload>
    <WhisperModelName>ggml-small-q8_0.bin</WhisperModelName>
    <WhisperModelUrl>https://huggingface.co/ggerganov/whisper.cpp/resolve/5359861c739e955e79d9a303bcbc70fb988958b1/ggml-small-q8_0.bin</WhisperModelUrl>
    <WhisperModelSha256>49c8fb02b65e6049d5fa6c04f81f53b867b5ec9540406812c643f177317f779f</WhisperModelSha256>
    <WhisperModelCache>$(MSBuildProjectDirectory)/obj/whisper/</WhisperModelCache>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <!-- Зависимость Whisper.net.Runtime (macOS): явно, чтобы её build-файлы не подключились -->
    <PackageReference Include="Whisper.net.Runtime.Metal" Version="1.9.1" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="DownloadWhisperModel" Condition="'$(WhisperDownload)' == 'true' And !Exists('$(WhisperModelCache)$(WhisperModelName)')">
    <Message Importance="high" Text="Whisper: качаю $(WhisperModelName) (264 МБ) в $(WhisperModelCache)" />
    <MakeDir Directories="$(WhisperModelCache)" />
    <DownloadFile SourceUrl="$(WhisperModelUrl)" DestinationFolder="$(WhisperModelCache)" DestinationFileName="$(WhisperModelName).part"
                  Retries="2" ContinueOnError="WarnAndContinue" />
    <GetFileHash Files="$(WhisperModelCache)$(WhisperModelName).part" Algorithm="SHA256" Condition="Exists('$(WhisperModelCache)$(WhisperModelName).part')">
      <Output TaskParameter="Hash" PropertyName="WhisperModelHash" />
    </GetFileHash>
    <Warning Condition="Exists('$(WhisperModelCache)$(WhisperModelName).part') And '$(WhisperModelHash)' != '$(WhisperModelSha256)'"
             Text="Whisper: у скачанной $(WhisperModelName) не та SHA-256 ($(WhisperModelHash)), удаляю. Мод будет работать на одном Vosk" />
    <Delete Condition="'$(WhisperModelHash)' != '$(WhisperModelSha256)'" Files="$(WhisperModelCache)$(WhisperModelName).part" />
    <Move Condition="'$(WhisperModelHash)' == '$(WhisperModelSha256)'" SourceFiles="$(WhisperModelCache)$(WhisperModelName).part"
          DestinationFiles="$(WhisperModelCache)$(WhisperModelName)" />
  </Target>

  <Target Name="CopyWhisper" AfterTargets="Build" DependsOnTargets="DownloadWhisperModel">
    <ItemGroup>
      <WhisperCpu Include="$(PkgWhisper_net_Runtime)/build/win-x64/*.dll" />
      <WhisperVulkan Include="$(PkgWhisper_net_Runtime_Vulkan)/build/win-x64/*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(WhisperCpu)" DestinationFolder="$(TargetDir)whisper/cpu" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WhisperVulkan)" DestinationFolder="$(TargetDir)whisper/vulkan" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(WhisperModelCache)$(WhisperModelName)" DestinationFolder="$(TargetDir)whisper" SkipUnchangedFiles="true"
          Condition="Exists('$(WhisperModelCache)$(WhisperModelName)')" />
    <Warning Condition="!Exists('$(WhisperModelCache)$(WhisperModelName)')"
             Text="Whisper: нет модели $(WhisperModelName), колонка будет распознавать только Vosk" />
  </Target>

  <Target Name="CopyWhisperToPluginDir" AfterTargets="CopyToPluginDir" DependsOnTargets="CopyWhisper" Condition="'$(PluginDir)' != ''">
    <ItemGroup>
      <WhisperFiles Include="$(TargetDir)whisper/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(WhisperFiles)" DestinationFolder="$(PluginDir)\$(AssemblyName)\whisper\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
  <!-- ==== /Whisper ==== -->

  <Target Name="CopyToPluginDir" AfterTargets="CopyVosk;CopyAliceSemantic" Condition="'$(PluginDir)' != ''">
    <MakeDir Directories="$(PluginDir)\$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)SidiuszCustomItems.Items.dll;$(TargetDir)Vosk.dll" DestinationFolder="$(PluginDir)\$(AssemblyName)" />
    <ItemGroup>
      <VoskFiles Include="$(TargetDir)vosk/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(VoskFiles)" DestinationFolder="$(PluginDir)\$(AssemblyName)\vosk\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <AliceSemanticFiles Include="$(TargetDir)alice-semantic/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(AliceSemanticFiles)" DestinationFolder="$(PluginDir)\$(AssemblyName)\alice-semantic\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(None->WithMetadataValue('Extension', '.txt'))" DestinationFolder="$(PluginDir)\$(AssemblyName)\translations" />
    <Copy SourceFiles="..\Bundles\sidiuszcustomitems" DestinationFolder="$(PluginDir)\$(AssemblyName)" Condition="Exists('..\Bundles\sidiuszcustomitems')" />
  </Target>

</Project>
