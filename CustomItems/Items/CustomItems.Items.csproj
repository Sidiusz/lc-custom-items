<Project Sdk="Microsoft.NET.Sdk">

  <!-- Скрипты предметов и ItemRegistry. Отдельная сборка без BepInEx и LethalLib:
       её DLL кладётся в Unity (Assets/Plugins/SidiuszCustomItems), и Unity должен суметь её
       загрузить, имея только библиотеки игры. Префабы и ассеты в бандле ссылаются
       на классы именно этой сборки. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SidiuszCustomItems.Items</AssemblyName>
    <RootNamespace>CustomItems</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
    <!-- Публицизированные библиотеки игры (Assembly-CSharp и т.д.), только для компиляции -->
    <PackageReference Include="LethalCompany.GameLibs.Steam" Version="81.0.5-ngd.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Звуки рвоты и отрыжки Егермейстера (Tools/Jagermeister/vomit_sounds.py), читаются кодом -->
  <ItemGroup>
    <EmbeddedResource Include="Sounds\*.wav" LogicalName="SidiuszCustomItems.Items.%(Filename).wav" />
  </ItemGroup>

  <!-- Звуки, которые грузит EmbeddedAudio: лежат с остальным аудио в Art/Audio, встраиваются в DLL -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Assets\Sources\Art\Audio\Adrenaline\*.wav" LogicalName="SidiuszCustomItems.Sounds.%(Filename).wav" />
    <EmbeddedResource Include="..\..\Assets\Sources\Art\Audio\Vape\*.wav" LogicalName="SidiuszCustomItems.Sounds.%(Filename).wav" />
  </ItemGroup>

  <!-- Модели и текстуры вейпов (Tools/Vape/model.py): VapeModels собирает из них меши в игре, Unity не нужен -->
  <ItemGroup>
    <EmbeddedResource Include="Models\*.mdl.gz" LogicalName="SidiuszCustomItems.Models.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\Assets\Sources\Art\Textures\Vape*\Vape*Body.png" LogicalName="SidiuszCustomItems.Textures.%(Filename).png" />
  </ItemGroup>

</Project>
