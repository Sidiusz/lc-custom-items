<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SidiuszCustomItems</AssemblyName>
    <RootNamespace>CustomItems</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- BepInEx и UnityEngine.Modules 2022.x лежат в фиде BepInEx, а не на nuget.org -->
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>

    <!-- Путь к папке BepInEx/plugins профиля r2modman/Gale. Если задан, после сборки
         DLL и AssetBundle копируются туда автоматически. Пример:
         dotnet build -p:PluginDir="C:\Users\me\AppData\Roaming\r2modmanPlus-local\LethalCompany\profiles\Dev\BepInEx\plugins" -->
    <PluginDir></PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
    <!-- Публицизированные библиотеки игры (Assembly-CSharp и т.д.), только для компиляции -->
    <PackageReference Include="LethalCompany.GameLibs.Steam" Version="81.0.5-ngd.0" PrivateAssets="all" />
    <PackageReference Include="Evaisa.LethalLib" Version="1.2.0" PrivateAssets="all" />
    <!-- Офлайн-распознавание речи для Яндекс Станции. Нативные библиотеки берём сами (ниже), а не из build/ пакета:
         тот кладёт их под ОС сборки, а игре нужны Windows x64 -->
    <PackageReference Include="Vosk" Version="0.3.38" ExcludeAssets="build" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Скрипты предметов собираются отдельной сборкой SidiuszCustomItems.Items (см. Items/) -->
  <ItemGroup>
    <Compile Remove="Items/**" />
    <None Remove="Items/**" />
    <ProjectReference Include="Items\CustomItems.Items.csproj" />
  </ItemGroup>

  <!-- Перевод для русификатора LethalRussian -->
  <ItemGroup>
    <None Include="translations\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- AssetBundle из Unity кладётся в Bundles/ в корне репозитория -->
  <ItemGroup>
    <None Include="..\Bundles\sidiuszcustomitems" Condition="Exists('..\Bundles\sidiuszcustomitems')" CopyToOutputDirectory="PreserveNewest" Link="sidiuszcustomitems" />
  </ItemGroup>

  <!-- Vosk для Яндекс Станции: vosk/ рядом с DLL мода (нативные библиотеки Windows x64 и русская модель).
       Модель (~45 МБ) скачивается один раз в obj/ при первой сборке. -->
  <PropertyGroup>
    <VoskModelName>vosk-model-small-ru-0.22</VoskModelName>
    <VoskModelCache>$(MSBuildProjectDirectory)/obj/vosk</VoskModelCache>
  </PropertyGroup>

  <Target Name="FetchVoskModel" BeforeTargets="Build" Condition="!Exists('$(VoskModelCache)/$(VoskModelName)/am')">
    <DownloadFile SourceUrl="https://alphacephei.com/vosk/models/$(VoskModelName).zip" DestinationFolder="$(VoskModelCache)" />
    <Unzip SourceFiles="$(VoskModelCache)/$(VoskModelName).zip" DestinationFolder="$(VoskModelCache)" />
    <Delete Files="$(VoskModelCache)/$(VoskModelName).zip" />
  </Target>

  <Target Name="CopyVosk" AfterTargets="Build">
    <ItemGroup>
      <VoskNative Include="$(PkgVosk)/build/lib/win-x64/*.dll" />
      <VoskModel Include="$(VoskModelCache)/$(VoskModelName)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="$(PkgVosk)/lib/netstandard2.0/Vosk.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VoskNative)" DestinationFolder="$(TargetDir)vosk" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VoskModel)" DestinationFolder="$(TargetDir)vosk/model-ru/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyToPluginDir" AfterTargets="CopyVosk" Condition="'$(PluginDir)' != ''">
    <MakeDir Directories="$(PluginDir)\$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)SidiuszCustomItems.Items.dll;$(TargetDir)Vosk.dll" DestinationFolder="$(PluginDir)\$(AssemblyName)" />
    <ItemGroup>
      <VoskFiles Include="$(TargetDir)vosk/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(VoskFiles)" DestinationFolder="$(PluginDir)\$(AssemblyName)\vosk\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(None->WithMetadataValue('Extension', '.txt'))" DestinationFolder="$(PluginDir)\$(AssemblyName)\translations" />
    <Copy SourceFiles="..\Bundles\sidiuszcustomitems" DestinationFolder="$(PluginDir)\$(AssemblyName)" Condition="Exists('..\Bundles\sidiuszcustomitems')" />
  </Target>

</Project>
