<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SidiuszCustomItems</AssemblyName>
    <RootNamespace>CustomItems</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- BepInEx и UnityEngine.Modules 2022.x лежат в фиде BepInEx, а не на nuget.org -->
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>

    <!-- Путь к папке BepInEx/plugins профиля r2modman/Gale. Если задан, после сборки
         DLL и AssetBundle копируются туда автоматически. Пример:
         dotnet build -p:PluginDir="C:\Users\me\AppData\Roaming\r2modmanPlus-local\LethalCompany\profiles\Dev\BepInEx\plugins" -->
    <PluginDir></PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
    <!-- Публицизированные библиотеки игры (Assembly-CSharp и т.д.), только для компиляции -->
    <PackageReference Include="LethalCompany.GameLibs.Steam" Version="81.0.5-ngd.0" PrivateAssets="all" />
    <PackageReference Include="Evaisa.LethalLib" Version="1.2.0" PrivateAssets="all" />
    <!-- Офлайн-распознавание речи для Яндекс Станции. Нативные библиотеки берём сами (ниже), а не из build/ пакета:
         тот кладёт их под ОС сборки, а игре нужны Windows x64 -->
    <PackageReference Include="Vosk" Version="0.3.38" ExcludeAssets="build" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Скрипты предметов собираются отдельной сборкой SidiuszCustomItems.Items (см. Items/) -->
  <ItemGroup>
    <Compile Remove="Items/**" />
    <None Remove="Items/**" />
    <ProjectReference Include="Items\CustomItems.Items.csproj" />
  </ItemGroup>

  <!-- Перевод для русификатора LethalRussian -->
  <ItemGroup>
    <None Include="translations\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="intents.txt" LogicalName="SidiuszCustomItems.intents.txt" />
  </ItemGroup>

  <!-- AssetBundle из Unity кладётся в Bundles/ в корне репозитория -->
  <ItemGroup>
    <None Include="..\Bundles\sidiuszcustomitems" Condition="Exists('..\Bundles\sidiuszcustomitems')" CopyToOutputDirectory="PreserveNewest" Link="sidiuszcustomitems" />
  </ItemGroup>

  <!-- Vosk для Яндекс Станции: vosk/ рядом с DLL мода (нативные библиотеки Windows x64 и русская модель).
       Модель своя, в Vosk/model-ru (собирает Tools/YandexStation/model/build.sh): акустика vosk-model-ru-0.42
       и граф со словами Алисы. final.mdl лежит в zip (53 МБ вместо 118), сборка распаковывает его. -->
  <ItemGroup>
    <None Remove="Vosk/**" />
  </ItemGroup>

  <Target Name="CopyVosk" AfterTargets="Build">
    <PropertyGroup>
      <VoskModelOut>$(TargetDir)vosk/model-ru</VoskModelOut>
    </PropertyGroup>
    <ItemGroup>
      <VoskNative Include="$(PkgVosk)/build/lib/win-x64/*.dll" />
      <VoskModel Include="Vosk/model-ru/**/*" Exclude="Vosk/model-ru/am/final.mdl.zip" />
    </ItemGroup>
    <Copy SourceFiles="$(PkgVosk)/lib/netstandard2.0/Vosk.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VoskNative)" DestinationFolder="$(TargetDir)vosk" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VoskModel)" DestinationFolder="$(VoskModelOut)/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Unzip SourceFiles="Vosk/model-ru/am/final.mdl.zip" DestinationFolder="$(VoskModelOut)/am" SkipUnchangedFiles="true" />
  </Target>

  <!-- Понимание вопросов Алисы по смыслу (AliceSemantic.cs): alice-semantic/ рядом с DLL мода.
       Модель rubert-mini-frida (f16 GGUF, 68 МБ) лежит в репозитории, её делает Tools/AliceSemantic/bert2gguf.py.
       llama.cpp для Windows x64 — из пакета LLamaSharp.Backend.Cpu (только нативные DLL, сам LLamaSharp не нужен):
       сборки под AVX2 и AVX, мод выбирает по процессору. -->
  <ItemGroup>
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <None Remove="AliceSemantic/**" />
  </ItemGroup>

  <Target Name="CopyAliceSemantic" AfterTargets="Build">
    <PropertyGroup>
      <AliceSemanticOut>$(TargetDir)alice-semantic</AliceSemanticOut>
      <AliceSemanticNative>$(PkgLLamaSharp_Backend_Cpu)/LLamaSharpRuntimes/win-x64/native</AliceSemanticNative>
    </PropertyGroup>
    <ItemGroup>
      <AliceSemanticDll Include="$(AliceSemanticNative)/avx2/ggml-base.dll;$(AliceSemanticNative)/avx2/ggml-cpu.dll;$(AliceSemanticNative)/avx2/ggml.dll;$(AliceSemanticNative)/avx2/llama.dll" Cpu="avx2" />
      <AliceSemanticDll Include="$(AliceSemanticNative)/avx/ggml-base.dll;$(AliceSemanticNative)/avx/ggml-cpu.dll;$(AliceSemanticNative)/avx/ggml.dll;$(AliceSemanticNative)/avx/llama.dll" Cpu="avx" />
    </ItemGroup>
    <Error Condition="!Exists('$(AliceSemanticNative)/avx2/llama.dll')" Text="Нет llama.dll в пакете LLamaSharp.Backend.Cpu ($(AliceSemanticNative))" />
    <Copy SourceFiles="@(AliceSemanticDll)" DestinationFolder="$(AliceSemanticOut)/%(Cpu)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="AliceSemantic/rubert-mini-frida-f16.gguf" DestinationFolder="$(AliceSemanticOut)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyToPluginDir" AfterTargets="CopyVosk;CopyAliceSemantic" Condition="'$(PluginDir)' != ''">
    <MakeDir Directories="$(PluginDir)\$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)SidiuszCustomItems.Items.dll;$(TargetDir)Vosk.dll" DestinationFolder="$(PluginDir)\$(AssemblyName)" />
    <ItemGroup>
      <VoskFiles Include="$(TargetDir)vosk/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(VoskFiles)" DestinationFolder="$(PluginDir)\$(AssemblyName)\vosk\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <AliceSemanticFiles Include="$(TargetDir)alice-semantic/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(AliceSemanticFiles)" DestinationFolder="$(PluginDir)\$(AssemblyName)\alice-semantic\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(None->WithMetadataValue('Extension', '.txt'))" DestinationFolder="$(PluginDir)\$(AssemblyName)\translations" />
    <Copy SourceFiles="..\Bundles\sidiuszcustomitems" DestinationFolder="$(PluginDir)\$(AssemblyName)" Condition="Exists('..\Bundles\sidiuszcustomitems')" />
  </Target>

</Project>
